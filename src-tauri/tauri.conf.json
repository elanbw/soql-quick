{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SOQL Quick",
  "version": "2.0.5",
  "identifier": "io.github.elanbw.soqlquick",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run frontend:dev -- --port 1420",
    "beforeBuildCommand": "npm test && npm run frontend"
  },
  "app": {
    "windows": [
      {
        "title": "SOQL Quick",
        "width": 1200,
        "height": 720,
        "minWidth": 820,
        "minHeight": 540,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Run read-only SOQL queries and copy results",
    "longDescription": "A private, read-only desktop utility for querying Salesforce with SOQL.",
    "copyright": "Copyright © 2026",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": null
    },
    "windows": {
      "wix": { "language": "en-US" },
      "nsis": { "installMode": "currentUser" }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
