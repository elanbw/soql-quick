# Copy to .env for local builds. Never commit a real client ID if your org’s policy
# treats it as internal configuration, even though OAuth public client IDs are
# not secrets.
SALESFORCE_CLIENT_ID=replace_with_external_client_app_consumer_key
SALESFORCE_LOGIN_URL=https://your-domain.my.salesforce.com
SALESFORCE_CALLBACK_URL=http://localhost:1410/callback
SALESFORCE_API_VERSION=66.0
